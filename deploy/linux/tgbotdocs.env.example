# TgBotDocs configuration for the Linux container (deploy/linux/compose.yaml).
# Copy to the host, outside the checkout, e.g. /srv/tgbotdocs/config/tgbotdocs.env,
# owned by root:10001 with mode 0640. compose.yaml mounts it read-only at
# /config/tgbotdocs.env and sets TGBOTDOCS_CONFIG to that path.
# Paths below are paths inside the container. Never commit the filled copy.
DATA_ROOT=/data
FROZEN_CONFIG=/data/frozen/frozen-t01b.json
TEMPORARY_ROOT=/data/temporary
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# Use a random password of at least 16 characters.
SHARED_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# The password must equal the content of the database password file mounted
# into the db service (default /srv/tgbotdocs/config/db-password). Use a
# hexadecimal password so that it needs no URL encoding.
DATABASE_URL=postgresql+psycopg://tgbotdocs:REPLACE_WITH_DB_PASSWORD@db:5432/tgbotdocs
RUNTIME_PORT=18081
OPERATOR_TELEGRAM_IDS=
INACTIVITY_S=900
# A processing-budget change must be calibrated with the recognition config.
PROCESSING_S=1800
QUEUE_TIMEOUT_S=900
ALBUM_QUIET_S=2
ADMITTED_JOBS=8
DOWNLOAD_LIMIT=2
DELIVERY_S=60
DELIVERY_ATTEMPTS=3
# The image's llama-server (Linux build of the pinned llama.cpp release) and
# its SHA-256, computed on the Linux host from the pinned image
# (INSTALL_LINUX.md, "Pin the runtime executable"). Both are required; the
# application refuses to start while the hash is empty. Startup then alerts
# runtime_executable_differs_from_frozen (ED-017).
RUNTIME_EXECUTABLE=/app/llama-server
RUNTIME_EXECUTABLE_SHA256=
