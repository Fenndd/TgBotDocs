# Copy outside the checkout; the application never reads this tracked example.
# Start: python -m tgbotdocs run --config <absolute path to the copy>
# Check without Telegram: python -m tgbotdocs check --config <same path>
# Windows data paths deliberately stay outside virtualized LOCALAPPDATA.
DATA_ROOT=C:\TgBotDocsData\prod
FROZEN_CONFIG=C:\TgBotDocsData\prod\frozen\frozen-t01b.json
# Default: DATA_ROOT\temporary. If set, use only a dedicated empty directory.
# TEMPORARY_ROOT=C:\TgBotDocsData\prod\temporary
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# Use a random password of at least 16 characters.
SHARED_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:55432/tgbotdocs_dev
RUNTIME_PORT=18081
OPERATOR_TELEGRAM_IDS=
INACTIVITY_S=900
# A processing-budget change must be calibrated with the recognition config.
PROCESSING_S=1800
QUEUE_TIMEOUT_S=900
ALBUM_QUIET_S=2
ADMITTED_JOBS=8
DOWNLOAD_LIMIT=2
DELIVERY_S=60
DELIVERY_ATTEMPTS=3
# Optional relocation of the calibrated executable, with its frozen SHA-256.
# A different binary is refused and requires a new calibration. Linux platform
# calibration/acceptance is pending; do not transfer the Windows freeze silently.
# RUNTIME_EXECUTABLE=/opt/llama/llama-server
# RUNTIME_EXECUTABLE_SHA256=
